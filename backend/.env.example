DATABASE_URL=sqlite:///data/gateway.db
CODEX_BINARY=codex
# Leave empty to use the default model configured by the local Codex installation.
# Set a model name only when this deployment intentionally needs an override.
CODEX_MODEL=
CODEX_RUNTIME_HOME=
CODEX_WORKING_DIRECTORY=
CODEX_TIMEOUT_SECONDS=2000
# Enable only for a trusted working directory that is intentionally not a Git checkout.
CODEX_SKIP_GIT_REPO_CHECK=false
# Recommended for backend workers so desktop plugins and profiles cannot affect execution.
CODEX_IGNORE_USER_CONFIG=true

# Optional OpenAI-compatible Agent backends. Keys stay on the backend and are
# never returned by the provider catalogue endpoint.
AGENT_API_TIMEOUT_SECONDS=2000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.2
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3

GITEA_URL=<gitea-url>
GITEA_TOKEN=<bridge-service-token>
GITEA_OWNER=<org>
GITEA_REPO=docs
GITEA_BASE_BRANCH=main
GITEA_REVIEW_BRANCH_PREFIX=prd-review/
GITEA_TIMEOUT_SECONDS=20

# Local development identity. Keep the service bound to loopback in this mode.
FIRSTFLIGHT_IDENTITY_MODE=local
FIRSTFLIGHT_ACTOR_ID=owner-1

# For a trusted reverse proxy, use proxy mode and configure the header instead.
# FIRSTFLIGHT_IDENTITY_MODE=proxy
# FIRSTFLIGHT_TRUSTED_ACTOR_HEADER=X-FirstFlight-Actor

# Explicit browser origins for cross-origin development. Production should prefer same-origin.
FIRSTFLIGHT_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# Optional PRD HTML prototype generation through the current 21st/Magic MCP.
# Create a fresh key at https://21st.dev/mcp. Legacy Magic keys no longer work.
# Leave empty for auto-enable when API_KEY_21ST is set; use false to disable.
MAGIC_MCP_ENABLED=
MAGIC_MCP_URL=https://21st.dev/api/mcp
MAGIC_MCP_API_KEY_ENV=API_KEY_21ST
API_KEY_21ST=
MAGIC_MCP_TOOL_TIMEOUT_SECONDS=300

# Shared WeKnora workspace integration. Credentials stay in the backend only.
WEKNORA_BASE_URL=http://192.168.240.70:9971/api/v1
WEKNORA_WEB_URL=http://192.168.240.70:9972
WEKNORA_API_KEY=
WEKNORA_ADMIN_EMAIL=
WEKNORA_ADMIN_PASSWORD=
WEKNORA_PERSONAL_TENANT_ID=10000
WEKNORA_TIMEOUT_SECONDS=30
